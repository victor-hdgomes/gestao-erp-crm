# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# DATABASE_URL  -> pooled connection (PgBouncer, port 6543) used by the app
# DIRECT_URL    -> direct connection (port 5432) used by prisma migrate
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Security
# AUTH_SECRET          -> signs session cookies. openssl rand -base64 32
# APP_ENCRYPTION_KEY   -> master key for integration credentials at rest (AES-256-GCM).
#                         Must be 32 bytes, base64 encoded. openssl rand -base64 32
#                         Rotating it invalidates every stored credential.
# ---------------------------------------------------------------------------
AUTH_SECRET=""
APP_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Seed
# SEED_ADMIN_*  -> first administrator. Obrigatórios quando SEED_DEMO=false.
# SEED_DEMO     -> "true" cria os clientes fictícios de treinamento,
#                  "false" recusa. Sem a variável, só fora de NODE_ENV=production.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@local.test"
SEED_ADMIN_PASSWORD="Admin@123456"
SEED_DEMO="true"
